                if last_reset:
                    from datetime import datetime
                    last_reset_date = datetime.fromisoformat(last_reset)
                    days_since_reset = (datetime.now() - last_reset_date).days
                    
                    if days_since_reset >= 730:  # 2 years = 730 days
